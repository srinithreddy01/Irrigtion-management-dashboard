# AquaFarm Environment Variables
# Supabase Database Configuration (provide your Supabase Project URL and API Key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Direct or Pooled Postgres Connection URL (for automated table migrations)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
